var bands = ['B2', 'B3', 'B4', 'B8', 'B11', 'B12'];
var training = composite2025.select(bands).sampleRegions({
  collection: trainingPoints,
  properties: ['kelas'],
  scale: 30
});
var classifier = ee.Classifier.smileRandomForest(50)
  .train({features: training, classProperty: 'kelas', inputProperties: bands});

var lulc2018 = composite2018.select(bands).classify(classifier);
var lulc2020 = composite2020.select(bands).classify(classifier);
var lulc2022 = composite2022.select(bands).classify(classifier);
