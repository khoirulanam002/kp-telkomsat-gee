var aoi = ee.Geometry.Rectangle([112.45, -7.65, 112.95, -7.00]);
Map.centerObject(aoi, 10);

function maskClouds(image) {
  var scl = image.select('SCL');
  var mask = scl.neq(3).and(scl.neq(8)).and(scl.neq(9)).and(scl.neq(10));
  return image.updateMask(mask);
}

function buatComposite(tahun) {
  return ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')
    .filterBounds(aoi)
    .filterDate(tahun + '-01-01', (tahun + 1) + '-01-01')
    .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 60))
    .map(maskClouds)
    .median()
    .clip(aoi);
}

var composite2018 = buatComposite(2018);
var composite2020 = buatComposite(2020);
var composite2022 = buatComposite(2022);
var composite2025 = buatComposite(2025);

