Map.addLayer(lulc2025, {min: 0, max: 4, palette: palette}, 'LULC 2025', true);

// 8. ACCURACY ASSESSMENT (seed=42, 70/30 split)
var validated       = training.randomColumn('random', 42);
var trainSet        = validated.filter(ee.Filter.lt('random', 0.7));
var testSet         = validated.filter(ee.Filter.gte('random', 0.7));
var classifierFinal = ee.Classifier.smileRandomForest(50)
  .train({features: trainSet, classProperty: 'kelas', inputProperties: bands});
var confMatrix = testSet.classify(classifierFinal).errorMatrix('kelas', 'classification');
print('Confusion Matrix P05:', confMatrix);
print('Overall Accuracy P05:', confMatrix.accuracy());
print('Kappa Coefficient P05:', confMatrix.kappa());

// 9. HITUNG AREA PER KELAS PER TAHUN (km²)
function hitungArea(lulcImage, label) {
  var areaImage = ee.Image.pixelArea().divide(1e6);
  var area = areaImage.addBands(lulcImage).reduceRegion({
    reducer: ee.Reducer.sum().group({groupField: 1, groupName: 'kelas'}),
    geometry: aoi,
    scale: 100,
    maxPixels: 1e9
  });
  print('=== Area per kelas (km2) — ' + label + ' ===', area);
}
hitungArea(lulc2018, '2018');
hitungArea(lulc2020, '2020');
hitungArea(lulc2022, '2022');
hitungArea(lulc2025, '2025');

// 10. CHART TREN LULC 2018–2025
function areaPerKelas(lulcImage, tahun) {
  var areaImage = ee.Image.pixelArea().divide(1e6);
  var areas = ee.List([0, 1, 2, 3, 4]).map(function(kelas) {
    var mask = lulcImage.eq(ee.Number(kelas));
    var area = areaImage.updateMask(mask).reduceRegion({
      reducer: ee.Reducer.sum(),
      geometry: aoi,
      scale: 100,
      maxPixels: 1e9
    });
    return ee.Number(area.values().get(0));
  });
  return ee.Feature(null, {
    'year':       tahun,
    'Permukiman': areas.get(0),
    'Vegetasi':   areas.get(1),
    'Air':        areas.get(2),
    'Tambak':     areas.get(3),
    'Industri':   areas.get(4)
  });
}
var trendFC = ee.FeatureCollection([
  areaPerKelas(lulc2018, 2018),
  areaPerKelas(lulc2020, 2020),
  areaPerKelas(lulc2022, 2022),
  areaPerKelas(lulc2025, 2025)
]);
var chart = ui.Chart.feature.byFeature(
    trendFC, 'year', ['Permukiman', 'Vegetasi', 'Air', 'Tambak', 'Industri'])
  .setChartType('ColumnChart')
  .setOptions({
    title: 'Tren Luas LULC Surabaya-Sidoarjo-Gresik 2018–2025 (km²)',
    hAxis: {title: 'Tahun', format: '####'},
    vAxis: {title: 'Luas (km²)'},
    colors: ['d7191c', '1a9641', '2b83ba', 'fdae61', '7b3294']
  });
print(chart);


function exportGeoJSON(lulcImage, tahun) {
  var vectors = lulcImage.reduceToVectors({
    geometry: aoi,
    scale: 100,
    geometryType: 'polygon',
    eightConnected: false,
    labelProperty: 'kelas',
    maxPixels: 1e9
  });
  Export.table.toDrive({
    collection: vectors,
    description: 'Praktikum05_LULC_' + tahun,
    fileFormat: 'GeoJSON',
    folder: 'GEE_KP_Telkomsat'
  });
}

